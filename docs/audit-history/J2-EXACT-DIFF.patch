+package com.kartgen.hireflow.webhook;
+
+import com.kartgen.hireflow.common.CryptoUtil;
+import com.kartgen.hireflow.config.HireFlowProperties;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.context.annotation.Profile;
+import org.springframework.stereotype.Component;
+
+import java.util.UUID;
+
+/**
+ * LOCAL DEVELOPMENT ONLY (profile "local").
+ *
+ * Provisions a stable webhook credential for the seeded demo organization so
+ * developers can exercise the signed webhook contract without calling the
+ * credential API first. The secret comes from the local-only
+ * `hireflow.webhook.local-dev-secret` property, is stored encrypted at rest
+ * like any other credential, and is NEVER logged.
+ *
+ * This seeder does not exist in the prod profile; production credentials are
+ * provisioned exclusively through POST /api/v1/webhook-credentials by an
+ * authenticated OWNER or ADMIN. The legacy global shared secret
+ * (X-HireFlow-Webhook-Secret) is retired: no profile accepts it.
+ */
+@Slf4j
+@Component
+@Profile("local")
+@RequiredArgsConstructor
+public class LocalWebhookDevCredentialSeeder implements ApplicationRunner {
+
+    /** Stable key id for the local demo credential (16 hex chars after the prefix). */
+    public static final String LOCAL_DEMO_KEY_ID = "whk_0a11c0de00000001";
+    private static final String LOCAL_DEMO_ORG_ID = "11111111-1111-1111-1111-111111111111";
+
+    private final WebhookCredentialRepository credentialRepo;
+    private final HireFlowProperties props;
+
+    @Override
+    public void run(ApplicationArguments args) {
+        String keyId = LOCAL_DEMO_KEY_ID;
+        if (credentialRepo.findByKeyId(keyId).isPresent()) {
+            return;
+        }
+        credentialRepo.save(WebhookCredential.builder()
+                .organizationId(UUID.fromString(LOCAL_DEMO_ORG_ID))
+                .keyId(keyId)
+                .encryptedSecret(CryptoUtil.encrypt(
+                        props.getWebhook().getLocalDevSecret(), props.getCrypto().getSecretKey()))
+                .status(WebhookCredential.STATUS_ACTIVE)
+                .build());
+        log.info("Local development webhook credential ready: keyId={} org={}", keyId, LOCAL_DEMO_ORG_ID);
+    }
+}
