+package com.kartgen.hireflow.security;
+
+import jakarta.servlet.http.Part;
+import org.springframework.web.multipart.MultipartException;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/**
+ * Minimal, strict-ish multipart/form-data parser over an in-memory byte
+ * array. Used by {@link WebhookBodyCachingRequestWrapper} so that parts
+ * remain parseable after the raw body has been consumed for HMAC
+ * verification.
+ *
+ * Supports: binary part bodies, quoted name/filename attributes,
+ * per-part Content-Type, CRLF and bare-LF line breaks. Does not write
+ * parts to disk - webhook bodies are capped by the caller.
+ */
+final class MultipartBodyParser {
+
+    private MultipartBodyParser() {}
+
+    static List<Part> parse(byte[] body, String contentType) {
+        String boundary = extractBoundary(contentType);
+        byte[] delimiter = ("--" + boundary).getBytes(StandardCharsets.US_ASCII);
+        List<Part> parts = new ArrayList<>();
+
+        int pos = indexOf(body, delimiter, 0);
+        if (pos < 0) {
+            throw new MultipartException("Malformed multipart body: boundary not found");
+        }
+        pos += delimiter.length;
+
+        while (true) {
+            if (matches(body, pos, "--")) {
+                break; // closing delimiter
+            }
+            pos = skipLineBreak(body, pos);
+
+            int headerEnd = findHeaderBodySeparator(body, pos);
+            if (headerEnd < 0) {
+                throw new MultipartException("Malformed multipart part: missing header terminator");
+            }
+            Map<String, List<String>> headers = parseHeaders(
+                    new String(body, pos, headerEnd - pos, StandardCharsets.UTF_8));
+            int contentStart = headerEnd + lineBreakLength(body, headerEnd);
+
+            int nextDelimiter = indexOf(body, delimiter, contentStart);
+            if (nextDelimiter < 0) {
+                throw new MultipartException("Malformed multipart body: unterminated part");
+            }
+            int contentEnd = nextDelimiter;
+            if (contentEnd > contentStart && body[contentEnd - 1] == '\n') contentEnd--;
+            if (contentEnd > contentStart && body[contentEnd - 1] == '\r') contentEnd--;
+
+            byte[] content = Arrays.copyOfRange(body, contentStart, contentEnd);
+            parts.add(new CachedPart(headers, content));
+            pos = nextDelimiter + delimiter.length;
+        }
+        return parts;
+    }
+
+    private static String extractBoundary(String contentType) {
+        for (String segment : contentType.split(";")) {
+            String trimmed = segment.trim();
+            if (trimmed.regionMatches(true, 0, "boundary=", 0, 9)) {
+                String boundary = trimmed.substring(9).trim();
+                if (boundary.length() >= 2 && boundary.startsWith("\"") && boundary.endsWith("\"")) {
+                    boundary = boundary.substring(1, boundary.length() - 1);
+                }
+                if (boundary.isEmpty()) {
+                    throw new MultipartException("Malformed multipart Content-Type: empty boundary");
+                }
+                return boundary;
+            }
+        }
+        throw new MultipartException("Malformed multipart Content-Type: boundary missing");
+    }
+
+    private static int findHeaderBodySeparator(byte[] body, int from) {
+        for (int i = from; i < body.length - 1; i++) {
+            if (body[i] == '\n') {
+                if (body[i + 1] == '\n') return i;              // LF LF -> headers end at first LF
+                if (body[i + 1] == '\r' && i + 3 < body.length
+                        && body[i + 2] == '\n' && body[i + 3] == '\n') {
+                    return i + 1;                               // LF CRLF variant
+                }
+            }
+            if (body[i] == '\r' && body[i + 1] == '\n'
+                    && i + 3 < body.length && body[i + 2] == '\r' && body[i + 3] == '\n') {
+                return i;                                       // CRLF CRLF
+            }
+        }
+        return -1;
+    }
+
+    private static int lineBreakLength(byte[] body, int separatorIndex) {
+        if (body[separatorIndex] == '\r') return 2;             // CRLF CRLF starts at CR
+        // LF LF (or LF CRLF LF): consume up to and including the second LF
+        return (body[separatorIndex + 1] == '\r') ? 3 : 2;
+    }
+
+    private static Map<String, List<String>> parseHeaders(String headerBlock) {
+        Map<String, List<String>> headers = new LinkedHashMap<>();
+        for (String line : headerBlock.split("\r\n|\n")) {
+            int colon = line.indexOf(':');
+            if (colon <= 0) continue;
+            String name = line.substring(0, colon).trim();
+            String value = line.substring(colon + 1).trim();
+            headers.computeIfAbsent(name.toLowerCase(Locale.ROOT), k -> new ArrayList<>()).add(value);
+        }
+        return headers;
+    }
+
+    private static int indexOf(byte[] haystack, byte[] needle, int from) {
+        if (needle.length == 0) return from;
+        outer:
+        for (int i = Math.max(from, 0); i <= haystack.length - needle.length; i++) {
+            for (int j = 0; j < needle.length; j++) {
+                if (haystack[i + j] != needle[j]) continue outer;
+            }
+            return i;
+        }
+        return -1;
+    }
+
+    private static boolean matches(byte[] body, int pos, String ascii) {
+        byte[] needle = ascii.getBytes(StandardCharsets.US_ASCII);
+        return pos >= 0 && pos + needle.length <= body.length && indexOf(body, needle, pos) == pos;
+    }
+
+    private static int skipLineBreak(byte[] body, int pos) {
+        if (pos < body.length && body[pos] == '\r') return pos + 2 <= body.length ? pos + 2 : pos + 1;
+        if (pos < body.length && body[pos] == '\n') return pos + 1;
+        return pos;
+    }
+
+    static final class CachedPart implements Part {
+
+        private final Map<String, List<String>> headers;
+        private final byte[] content;
+        private final String name;
+        private final String submittedFileName;
+        private final String contentType;
+
+        CachedPart(Map<String, List<String>> headers, byte[] content) {
+            this.headers = headers;
+            this.content = content;
+            String disposition = firstHeader(headers, "content-disposition");
+            this.name = attribute(disposition, "name");
+            this.submittedFileName = attribute(disposition, "filename");
