@@ -0,0 +1,113 @@
+package com.kartgen.hireflow.security;
+
+import jakarta.servlet.ReadListener;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.ServletInputStream;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletRequestWrapper;
+import jakarta.servlet.http.Part;
+import org.springframework.web.multipart.MultipartException;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/**
+ * Bounded, replayable request wrapper for webhook authentication.
+ *
+ * The HMAC signature must cover the exact raw request bytes, so the
+ * filter reads (and caches, up to a hard maximum) the full body before
+ * Spring MVC parses it. This wrapper then:
+ *  - replays the cached bytes to downstream consumers via
+ *    getInputStream()/getReader(),
+ *  - re-implements getParts()/getPart() over the cached bytes for
+ *    multipart/form-data, because the servlet container would otherwise
+ *    try to parse from the already-consumed connector stream,
+ *  - preserves the original Content-Type and all other headers.
+ *
+ * Buffering is bounded by maxBodyBytes; larger bodies fail fast with
+ * RequestBodyTooLargeException before any expensive processing.
+ */
+public class WebhookBodyCachingRequestWrapper extends HttpServletRequestWrapper {
+
+    private final byte[] body;
+    private Collection<Part> parsedParts;
+
+    public WebhookBodyCachingRequestWrapper(HttpServletRequest request, long maxBodyBytes) throws IOException {
+        super(request);
+        InputStream in = super.getInputStream();
+        ByteArrayOutputStream buffer = new ByteArrayOutputStream(16 * 1024);
+        byte[] chunk = new byte[8192];
+        long total = 0;
+        int read;
+        while ((read = in.read(chunk)) != -1) {
+            total += read;
+            if (total > maxBodyBytes) {
+                throw new RequestBodyTooLargeException(maxBodyBytes);
+            }
+            buffer.write(chunk, 0, read);
+        }
+        this.body = buffer.toByteArray();
+    }
+
+    public byte[] getContentAsByteArray() {
+        return body;
+    }
+
+    @Override
+    public ServletInputStream getInputStream() {
+        ByteArrayInputStream source = new ByteArrayInputStream(body);
+        return new ServletInputStream() {
+            @Override
+            public boolean isFinished() { return source.available() == 0; }
+
+            @Override
+            public boolean isReady() { return true; }
+
+            @Override
+            public void setReadListener(ReadListener readListener) {
+                throw new UnsupportedOperationException("Async reads are not supported for webhook requests");
+            }
+
+            @Override
+            public int read() { return source.read(); }
+
+            @Override
+            public int read(byte[] b, int off, int len) { return source.read(b, off, len); }
+        };
+    }
+
+    @Override
+    public BufferedReader getReader() {
+        return new BufferedReader(new InputStreamReader(getInputStream(), StandardCharsets.UTF_8));
+    }
+
+    @Override
+    public Collection<Part> getParts() throws IOException, ServletException {
+        String contentType = getContentType();
+        if (contentType != null && contentType.toLowerCase(Locale.ROOT).startsWith("multipart/form-data")) {
+            if (parsedParts == null) {
+                parsedParts = MultipartBodyParser.parse(body, contentType);
+            }
+            return parsedParts;
+        }
+        return super.getParts();
+    }
+
+    @Override
+    public Part getPart(String name) throws IOException, ServletException {
+        for (Part part : getParts()) {
+            if (part.getName().equals(name)) {
+                return part;
+            }
+        }
+        return null;
+    }
+
+    /** Thrown when the raw body exceeds the configured maximum before buffering completes. */
+    public static class RequestBodyTooLargeException extends RuntimeException {
+        public RequestBodyTooLargeException(long maxBodyBytes) {
+            super("Webhook body exceeds maximum of " + maxBodyBytes + " bytes");
+        }
+    }
+}
