+    // ── Helpers ─────────────────────────────────────────────────────────────
+
+    private record Hook(WebhookOrg org, Credential credential) {
+        UUID orgId() { return org.org().getId(); }
+        Organization organization() { return org.org(); }
+    }
+
+    private Hook hook() throws Exception {
