# Auto detect text files and perform LF normalization on checkout
* text=auto

# Shell scripts and executables must always have LF line endings
*.sh text eol=lf
hireflow-backend/mvnw text eol=lf
mvnw text eol=lf

# Windows batch files must have CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf
